# Variables de entorno de UNA Chat
# Copiar a `.env` y completar con los datos de tu aplicación en Auth0.
# `.env` está en .gitignore: nunca subir credenciales al repositorio.

# Dominio del tenant, SIN https://  (ej: dev-xxxxxxxx.us.auth0.com)
AUTH0_DOMAIN=

# Client ID de la aplicación SPA creada en Auth0 (es público, no es un secreto)
AUTH0_CLIENT_ID=

# true  = el chat exige autenticación (comportamiento normal)
# false = desactiva la autenticación (SOLO para pruebas automatizadas)
AUTH_REQUIRED=true

# Puerto del servidor local
PORT=3000
