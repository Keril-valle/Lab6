# Variables de entorno de UNA Chat
# Copiar a `.env` (local) o cargar en Vercel. `.env` está en .gitignore.
# No poner secretos aquí: el flujo SPA no usa client_secret.

# Dominio del tenant de Auth0, SIN https:// (ej: dev-xxxxxxxx.us.auth0.com)
AUTH0_DOMAIN=

# Client ID de la aplicación SPA en Auth0 (es público, no es un secreto)
AUTH0_CLIENT_ID=

# true  = el chat exige iniciar sesión (normal, usar siempre)
# false = desactiva la autenticación (SOLO para pruebas automatizadas)
AUTH_REQUIRED=true

# Puerto del servidor local (no aplica en Vercel)
PORT=3000

# Opcional. Dejar vacío en un despliegue solo en Vercel.
# Solo si el servidor de Socket.IO vive en otro host con proceso persistente.
SOCKET_URL=

# Opcional. Orígenes permitidos para el socket, separados por coma.
# Solo es necesario si SOCKET_URL apunta a otro host.
ALLOWED_ORIGINS=
